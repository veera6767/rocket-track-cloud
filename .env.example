# =====================================================================
# ROCKET TRACK CLOUD — ENVIRONMENT VARIABLES TEMPLATE
# =====================================================================

# Server listening port (Render automatically provides process.env.PORT)
PORT=3000

# Environment mode: 'development' or 'production'
# In production, server enforces >=16 char keys and warns if DATABASE_URL is missing.
NODE_ENV=production

# Write-only key used by the phone app via 'x-api-key' header (>=16 characters)
DEVICE_KEY=your_secret_phone_device_key_here_min16chars

# Read-only key used by viewers on dashboard and WebSocket via 'x-viewer-key' or '?key=' (>=16 characters)
VIEWER_KEY=your_viewer_access_key_here_min16chars

# Full control key for session deletion, device provisioning & pairing QR (>=16 characters)
ADMIN_KEY=your_super_secret_admin_key_here_min16chars

# PostgreSQL Database URL (Neon, Supabase, or Render Postgres).
# If omitted in non-production, falls back to local SQLite.
# In production, configure this so data persists across instance restarts.
DATABASE_URL=postgresql://user:password@ep-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Configurable CORS origins (comma-separated origins, or '*' for open access)
CORS_ORIGINS=*

# Optional data retention cleanup: automatically deletes sessions older than N days (0 = disabled)
RETENTION_DAYS=30
